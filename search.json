---
layout: null
sitemap: false
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%d/%m/%Y' | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | truncate: 200 | jsonify }},"text":{{ post.content | strip_html | normalize_whitespace | jsonify }},"categories":{{ post.categories | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
